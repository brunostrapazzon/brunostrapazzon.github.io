---
// Stroke icons drawn for this site.
interface Props { name: "arrow" | "external" | "back" | "sun" | "moon" | "menu" | "close" | "mail" | "chat" | "download"; }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "arrow" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "external" && <><path d="M7 17 17 7" /><path d="M8 7h9v9" /></>}
  {name === "back" && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {name === "sun" && <><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></>}
  {name === "moon" && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></>}
  {name === "chat" && <path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z" />}
  {name === "download" && <><path d="M12 4v11M7 10l5 5 5-5" /><path d="M5 20h14" /></>}
</svg>
